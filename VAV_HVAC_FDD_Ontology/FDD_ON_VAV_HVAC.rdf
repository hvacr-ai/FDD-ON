                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/y6g/ontologies/2025/FDD_ON_VAV_HVAC#VAVATU-DischargeAir-FanSpeedControl"/>
            </owl:Restriction>
        </rdfs:subClassOf>
